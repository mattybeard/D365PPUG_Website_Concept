{
  "name": "d365ppug",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "migrate": "tsx scripts/migrate.ts",
    "scrape": "tsx scripts/scrape.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "npm run scrape && npm run build:site",
    "build:site": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .server && tsx scripts/render.ts",
    "preview": "tsx scripts/serve.ts",
    "check:output": "tsx scripts/check-output.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.0.3",
    "cheerio": "^1.1.2",
    "marked": "^18.1.2",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  }
}
